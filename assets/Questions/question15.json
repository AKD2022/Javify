      "id": "v2-6",
      "type": "text",
      "question": "Which compares String contents?",
      "options": [
        {
          "type": "text",
          "value": "a.length = b.length"
        },
        {
          "type": "text",
          "value": "a.equals(b)"
        },
        {
          "type": "text",
          "value": "a = b"
        },
        {
          "type": "text",
          "value": "a == b always"
        }
      ],
      "answer": 1,
      "explanation": "equals compares the sequence of characters, whereas == compares references."
    },
