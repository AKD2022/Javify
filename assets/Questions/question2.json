        },
        {
          "type": "text",
          "value": "Its only possible name"
        },
        {
          "type": "text",
          "value": "The number of comments"
        },
        {
          "type": "text",
          "value": "The program goal"
        }
      ],
      "answer": 0,
      "explanation": "Types constrain values and operations such as arithmetic or method calls."
    },
    {
      "id": "v2-6",
      "type": "text",
      "question": "Can a local int variable be read before it is initialized?",
      "options": [
        {
          "type": "text",
          "value": "Only if its name is short"
        },
        {
          "type": "text",
          "value": "No, Java reports a compile-time error"
        },
        {
          "type": "text",
          "value": "Yes, it always contains zero"
        },
        {
          "type": "text",
          "value": "Yes, it contains null"
        }
      ],
      "answer": 1,
      "explanation": "Local variables must be definitely assigned before use."
    },
    {
      "id": "v2-7",
      "type": "text",
      "question": "Which is a boolean literal?",
      "options": [
        {
          "type": "text",
          "value": "0"
        },
        {
          "type": "text",
          "value": "False"
        },
        {
