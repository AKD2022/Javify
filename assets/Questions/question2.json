      "question": "Which declaration is valid?",
      "options": [
        {
          "type": "text",
          "value": "int 12count = 0;"
        },
        {
          "type": "text",
          "value": "int class = 0;"
        },
        {
          "type": "text",
          "value": "int count = \"12\";"
        },
        {
          "type": "text",
          "value": "int count = 12;"
        }
      ],
      "answer": 3,
      "explanation": "Identifiers cannot begin with a digit or be reserved keywords, and the assigned type must be compatible."
