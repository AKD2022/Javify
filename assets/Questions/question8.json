  "title": "1.8 Documentation with Comments",
  "topic": "1.8",
  "contentVersion": 2,
  "questions": [
    {
      "id": "v2-1",
      "type": "text",
      "question": "Which begins a single-line comment?",
      "options": [
        {
          "type": "text",
          "value": "//"
        },
        {
          "type": "text",
          "value": "/*/"
        },
        {
          "type": "text",
          "value": "##"
        },
        {
          "type": "text",
          "value": "<!--"
        }
      ],
      "answer": 0,
      "explanation": "// makes the remainder of the line a comment."
    },
    {
      "id": "v2-2",
      "type": "text",
      "question": "Which encloses a block comment?",
      "options": [
        {
          "type": "text",
          "value": "## ... ##"
        },
        {
          "type": "text",
          "value": "/* ... */"
        },
        {
          "type": "text",
          "value": "// ... //"
        },
        {
          "type": "text",
          "value": "<comment> ... </comment>"
        }
      ],
      "answer": 1,
      "explanation": "A block comment can span multiple lines until its closing marker."
    },
    {
      "id": "v2-3",
      "type": "text",
      "question": "Do comments normally execute as Java statements?",
      "options": [
        {
          "type": "text",
          "value": "Yes, after every loop"
        },
        {
          "type": "text",
          "value": "Only when they contain digits"
        },
        {
          "type": "text",
          "value": "No"
        },
        {
          "type": "text",
          "value": "Yes, before main"
        }
      ],
      "answer": 2,
      "explanation": "Comments are excluded from executable statements."
    },
    {
      "id": "v2-4",
      "type": "text",
      "question": "Which comment best explains intent?",
      "options": [
        {
          "type": "text",
          "value": "// Add one"
        },
        {
          "type": "text",
          "value": "// This is code"
        },
        {
          "type": "text",
          "value": "// Variable here"
        },
        {
          "type": "text",
          "value": "// Convert minutes to hours for the report"
        }
      ],
      "answer": 3,
      "explanation": "Useful comments explain purpose, assumptions, or non-obvious behavior."
    },
    {
      "id": "v2-5",
      "type": "text",
      "question": "Where should a method precondition be documented?",
      "options": [
        {
          "type": "text",
          "value": "In documentation associated with the method"
        },
        {
          "type": "text",
          "value": "Only in an unrelated class"
        },
        {
          "type": "text",
          "value": "Only in the file name"
        },
        {
          "type": "text",
          "value": "Nowhere if the code compiles"
        }
      ],
      "answer": 0,
      "explanation": "The caller needs to know the requirements before invoking the method."
    },
    {
      "id": "v2-6",
      "type": "text",
      "question": "What makes a postcondition useful?",
      "options": [
        {
          "type": "text",
          "value": "It replaces the method body"
        },
        {
          "type": "text",
          "value": "It describes the result or effect callers can rely on"
        },
        {
          "type": "text",
          "value": "It lists every local name"
        },
        {
          "type": "text",
          "value": "It repeats punctuation"
        }
      ],
      "answer": 1,
      "explanation": "A contract explains observable behavior rather than incidental implementation."
    },
    {
      "id": "v2-7",
      "type": "text",
      "question": "When behavior changes, what should happen to related comments?",
      "options": [
        {
          "type": "text",
          "value": "Delete every comment"
        },
        {
          "type": "text",
          "value": "Convert them to String variables"
        },
        {
          "type": "text",
          "value": "Update them to match the new behavior"
        },
        {
          "type": "text",
          "value": "Leave them unchanged"
        }
      ],
      "answer": 2,
      "explanation": "Misleading documentation can cause incorrect use even when the code is valid."
    },
    {
      "id": "v2-8",
      "type": "text",
      "question": "Which is a documentation comment opener?",
      "options": [
        {
          "type": "text",
          "value": "/**/ already closed"
        },
        {
          "type": "text",
          "value": "/// only"
        },
        {
          "type": "text",
          "value": "<!"
        },
        {
          "type": "text",
          "value": "/**"
        }
      ],
      "answer": 3,
      "explanation": "A /** ... */ comment can supply documentation for a declaration."
    },
