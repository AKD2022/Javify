      "type": "text",
      "question": "What initial value works for a sum accumulator?",
      "options": [
        {
          "type": "text",
          "value": "0"
        },
        {
          "type": "text",
          "value": "1 always"
        },
        {
          "type": "text",
          "value": "-1 always"
        },
        {
          "type": "text",
          "value": "The final loop bound always"
        }
      ],
      "answer": 0,
      "explanation": "Zero is the additive identity and gives the correct empty sum."
    },
    {
      "id": "v2-2",
      "type": "text",
      "question": "What initial value works for a product accumulator?",
      "options": [
        {
          "type": "text",
          "value": "The number of terms always"
        },
        {
          "type": "text",
          "value": "1"
        },
        {
          "type": "text",
          "value": "0"
        },
        {
          "type": "text",
          "value": "-1 always"
        }
      ],
      "answer": 1,
      "explanation": "One is the multiplicative identity; zero would force every product to zero."
    },
    {
      "id": "v2-3",
      "type": "text",
      "question": "Which operation extracts the last decimal digit of nonnegative int n?",
      "options": [
        {
          "type": "text",
          "value": "n * 10"
        },
        {
          "type": "text",
          "value": "n + 10"
        },
        {
          "type": "text",
          "value": "n % 10"
        },
        {
          "type": "text",
          "value": "n / 10"
        }
      ],
      "answer": 2,
      "explanation": "Remainder after division by 10 gives the units digit."
    },
    {
      "id": "v2-4",
      "type": "text",
      "question": "Which operation removes the last digit of nonnegative int n?",
      "options": [
        {
          "type": "text",
          "value": "n % 10"
        },
        {
          "type": "text",
          "value": "n + 10"
        },
        {
          "type": "text",
          "value": "n * 10"
        },
        {
          "type": "text",
          "value": "n / 10"
        }
      ],
      "answer": 3,
      "explanation": "Integer division by 10 truncates the units digit."
    },
    {
      "id": "v2-5",
      "type": "text",
      "question": "Why should a count increment only inside the match condition?",
      "options": [
        {
          "type": "text",
          "value": "To count matches rather than every iteration"
        },
        {
          "type": "text",
          "value": "To change its type"
        },
        {
          "type": "text",
          "value": "To avoid all comparisons"
        },
        {
          "type": "text",
          "value": "To make every result zero"
        }
      ],
      "answer": 0,
      "explanation": "An unconditional increment counts processed items, not qualifying items."
    },
